# Copiar a .env y completar. Nunca subir .env al repo.

# Diagnóstico por imagen — https://admin.kindwise.com (100 créditos gratis)
CROP_HEALTH_API_KEY=

# Identificación de malezas — https://my.plantnet.org (gratis, cuota diaria)
PLANTNET_API_KEY=

# Opcional: EPPO Global Database — https://data.eppo.int (registro gratis)
EPPO_TOKEN=

# LLM — como en la cátedra: Hugging Face Router (https://huggingface.co/settings/tokens)
HF_TOKEN=
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_BASE_URL=https://router.huggingface.co/v1   # o cualquier endpoint compatible con OpenAI (usar LLM_API_KEY)
